# Web application. No Telegram credentials required.
DATA_DIR=/data
DATA_RETENTION_HOURS=24
# Required for public deployment, at least 12 characters. Keep blank in Git.
WEB_ACCESS_PASSWORD=
# Optional if Railway supplies RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=
# Optional: configure here in the server environment, or use the web settings UI.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_JSON_MODE=auto
LLM_TIMEOUT_SECONDS=35
LLM_MAX_ATTEMPTS=3
# Documentation only: .env is not loaded automatically.
